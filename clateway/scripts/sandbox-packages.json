{
  "$comment": "What the agent sandbox images (Dockerfile) install: everything here goes into both the standard and the full image, \"office\" only into the full one. Source for SANDBOX_IMAGE_TOOLS / SANDBOX_NODE_PACKAGES / SANDBOX_PYTHON_PACKAGES in supabase/functions/_shared/ai-workforce/sandbox.ts (tests/unit/ai-workforce/sandboxImage.test.ts keeps them in step) and for the Clateway Claude Code plugin's scanner. Node packages are global (NODE_PATH) and linked into /workspace/node_modules at sandbox start, so they work without network.",
  "apt": [
    "git", "curl", "ca-certificates", "jq", "unzip", "zip",
    "ffmpeg", "sox", "libsox-fmt-mp3", "imagemagick", "librsvg2-bin", "graphviz", "libimage-exiftool-perl",
    "poppler-utils", "qpdf", "ghostscript", "pandoc",
    "tesseract-ocr", "tesseract-ocr-eng", "tesseract-ocr-nld", "tesseract-ocr-deu", "tesseract-ocr-fra",
    "libpango-1.0-0", "libpangoft2-1.0-0", "libharfbuzz-subset0",
    "fontconfig", "fonts-dejavu-core", "fonts-liberation", "fonts-noto-core", "fonts-noto-color-emoji", "fonts-inter"
  ],
  "apt_optional": ["gifski"],
  "office": {
    "$comment": "Only in the full image (Dockerfile build argument IMAGE_VARIANT=full, runtime clateway_workspace_full): LibreOffice headless adds ~500 MB, so the standard image stays small and starts faster.",
    "apt": ["libreoffice-core-nogui", "libreoffice-writer-nogui", "libreoffice-calc-nogui", "libreoffice-impress-nogui"],
    "tools": ["soffice", "libreoffice"]
  },
  "tools": [
    "bash", "node", "npm", "pnpm", "npx", "python3", "pip", "git", "curl", "jq", "zip", "unzip",
    "chromium", "playwright", "ffmpeg", "ffprobe", "gifski", "sox", "convert", "magick", "rsvg-convert", "dot",
    "exiftool", "pdftotext", "pdftoppm", "pdfinfo", "qpdf", "gs", "pandoc", "tesseract",
    "semgrep", "trivy", "syft"
  ],
